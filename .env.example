# Copy to .env.local and fill in from Supabase dashboard > Project Settings > API Keys.
# Use the publishable key only. Never put the secret/service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public address of the deployed app, no trailing slash. index.html uses it for
# the absolute link-preview URLs (og:url, og:image) that Teams/Slack require.
VITE_SITE_URL=https://<your-domain>
